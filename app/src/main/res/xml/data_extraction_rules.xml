<?xml version="1.0" encoding="utf-8"?>
<!-- Conversas e o perfil de Amigos não vão para o backup do Android: moram só
     no celular (desinstalar apaga). Android 12 em diante. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="social/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="social/" />
    </device-transfer>
</data-extraction-rules>
